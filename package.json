{
  "name": "rangkumin",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi keuangan pasangan berbasis Cloudflare Workers.",
  "license": "MIT",
  "author": "Andika Fadil",
  "homepage": "https://rangkumin.dikadevit.my.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andikafadil28/rangkumin.git"
  },
  "bugs": {
    "url": "https://github.com/andikafadil28/rangkumin/issues"
  },
  "funding": "https://buymeacoffee.com/dikadev",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev",
    "dev:frontend": "vite --config vite.config.ts",
    "dev:demo": "vite --config vite.config.ts --mode demo",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "docs:pdf": "node scripts/build-docs.mjs",
    "build:frontend": "vite build --config vite.config.ts",
    "build:demo": "vite build --config vite.config.ts --mode demo",
    "deploy:demo": "npm run build:demo && wrangler deploy --config wrangler.demo.jsonc",
    "build": "npm run build:frontend && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "types": "wrangler types --include-runtime=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env=\"\"",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local --env=\"\"",
    "db:migrations:list:development": "wrangler d1 migrations list DB --remote --env=\"\"",
    "db:migrations:list:production": "wrangler d1 migrations list DB --remote --env production",
    "db:seed:local": "wrangler d1 execute DB --local --env=\"\" --file seeds/development.sql",
    "db:seed:development": "wrangler d1 execute DB --remote --env=\"\" --file seeds/development.sql",
    "db:provision:production": "node scripts/provision-production.mjs",
    "access:secrets:production": "node scripts/set-access-secrets.mjs",
    "webpush:secrets:production": "node scripts/set-web-push-secrets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tests/tsconfig.json && tsc --noEmit --project frontend-tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:worker && npm run test:frontend",
    "test:worker": "vitest run",
    "test:frontend": "vitest run --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.5",
    "idb": "^8.0.3",
    "jose": "^6.2.11",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "marked": "^18.0.11",
    "prettier": "^3.9.0",
    "sharp": "^0.35.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
