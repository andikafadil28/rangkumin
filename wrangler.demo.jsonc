{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rangkumin-demo",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-demo",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "demo.rangkumin.dikadevit.my.id",
      "custom_domain": true,
    },
  ],
}
